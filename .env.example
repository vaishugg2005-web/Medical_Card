# ==============================================================================
# SECURE EMERGENCY MEDICAL HISTORY ACCESS SYSTEM (EMQ-HS)
# Environment Configuration Template
# ==============================================================================

# Application Environment (DEVELOPMENT | STAGING | PRODUCTION)
ENVIRONMENT=DEVELOPMENT
DEBUG=true
APP_NAME="Secure Emergency Medical Access System"
API_V1_STR=/api/v1

# Security & Cryptography
# Generate with: openssl rand -hex 32
SECRET_KEY=dev-insecure-secret-key-change-in-production-0123456789abcdef0123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
EMERGENCY_SESSION_EXPIRE_MINUTES=15

# Field-Level Encryption Simulation Key (AES-256 requires 32-byte hex key)
# In production, this key is retrieved from AWS KMS / CloudHSM envelope encryption.
LOCAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database Configuration
# Default to SQLite for friction-free local development and fast testing:
DATABASE_URL=sqlite:///./medical_system.db
# For Docker / PostgreSQL production deployments, use:
# DATABASE_URL=postgresql://emq_user:emq_password@localhost:5432/emq_db

# Redis Cache (Optional for dev, in-memory fallback enabled if offline)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000"

# AI Medical Summarization Provider
# Options: rule_based (offline zero-cost), openai (GPT-4o), ollama (local LLM)
AI_PROVIDER=rule_based
AI_API_KEY=""
AI_SERVICE_URL="https://api.openai.com/v1"
AI_MODEL_NAME="gpt-4o-mini"

# Document Storage Provider (local | s3)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR="./storage/medical_documents"
AWS_S3_BUCKET_NAME=""
AWS_REGION="us-east-1"

# Notification Provider (mock | twilio | aws_sns)
NOTIFICATION_PROVIDER=mock
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
EMERGENCY_SCAN_RATE_LIMIT_PER_MINUTE=15

# System Seed Account Passwords (Used only during initial DB seed in DEV)
DEMO_PATIENT_PASSWORD=PatientDemo123!
DEMO_DOCTOR_PASSWORD=DoctorDemo123!
DEMO_ADMIN_PASSWORD=AdminSecure123!
